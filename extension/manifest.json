{
  "manifest_version": 3,
  "name": "Wall-PC Chat Bridge",
  "version": "0.1.0",
  "description": "Detects explicit Wall-PC command blocks in ChatGPT and sends them to your local companion agent.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Wall-PC Bridge" }
}
